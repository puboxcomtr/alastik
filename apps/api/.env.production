JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_SECRET=PROD-SESSION-SECRET-CHANGE-THIS

# Authentication - PRODUCTION'DA ASLA BYPASS ETME!
DISABLE_AUTH=false

# Upload Configuration - Production paths
UPLOAD_BASE_PATH=/var/www/uploads
