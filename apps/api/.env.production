REDIS_PASSWORD=34gm4191M.

# PostgreSQL (Kullanılıyorsa)
# DATABASE_URL=postgresql://alastik:34gm4191M.@localhost:5432/alastik_admin

# JWT Configuration - PRODUCTION KEYS
JWT_SECRET=PROD-SUPER-SECRET-KEY-CHANGE-THIS-IN-REAL-PRODUCTION
JWT_REFRESH_SECRET=PROD-REFRESH-SECRET-KEY-CHANGE-THIS
