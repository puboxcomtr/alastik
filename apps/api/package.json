{
  "name": "@alastik/api",
  "version": "1.0.0",
  "description": "Yüksek Performanslı E-Ticaret Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "dotenv -e ../../.env -- nodemon src/server.js",
    "dev-simple": "nodemon src/server-simple.js",
    "cluster": "node src/cluster.js",
    "pm2": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "logs": "pm2 logs",
    "monitor": "pm2 monit",
    "build": "echo 'API build completed'",
    "clean": "rm -rf logs/* uploads/temp/*",
    "test": "jest",
    "lint": "eslint src/"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs",
    "express",
    "mongodb",
    "redis",
    "performance"
  ],
  "author": "Alastik.com",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.10.0",
    "google-auth-library": "^10.2.0",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "redis": "^4.6.7",
    "sharp": "^0.32.6",
    "soap": "^1.2.1",
    "winston": "^3.10.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "nodemon": "^3.1.10"
  }
}
