# ============================================
# apps/api/.env.example
# TEMPLATE - Copy to .env.local and fill in your values
# ============================================

# ⚠️ IMPORTANT: Never commit .env.local or .env.production to Git!
# This file is a template. Copy it to .env.local for development.

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development
PORT=3082

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Connection String
# Format: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://localhost:27017/alastik_db

# Redis (Optional - for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL (Optional - if using)
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT Secret Keys (Generate strong random strings)
JWT_SECRET=your-jwt-secret-key-here-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-here-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Session Secret
SESSION_SECRET=your-session-secret-here-min-32-chars

# Disable authentication for local development (true/false)
DISABLE_AUTH=true

# ===========================================
# API CONFIGURATION
# ===========================================
API_BASE_URL=http://localhost:3082
NEXT_PUBLIC_API_URL=http://localhost:3082/api
PUBLIC_URL=http://localhost:3082

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
UPLOAD_BASE_PATH=./public/uploads
STATIC_URL_PREFIX=/uploads

# CDN Configuration (Optional - for production)
# CDN_URL=https://cdn.yourdomain.com

# AWS S3 Configuration (Optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=

# ===========================================
# DIA ERP INTEGRATION
# ===========================================
# DIA API Endpoints
DIA_BASE_URL=https://your-company.ws.dia.com.tr
DIA_API_KEY=your-dia-api-key
DIA_USERNAME=your-dia-username
DIA_PASSWORD=your-dia-password
DIA_FIRMA_KODU=1
DIA_DONEM_KODU=2

# DIA Performance Tuning
DIA_LOGIN_TIMEOUT=600000
DIA_API_TIMEOUT=1800000
DIA_BATCH_TIMEOUT=2400000
DIA_API_BATCH_SIZE=1000
DIA_DB_BATCH_SIZE=500
DIA_REQUEST_DELAY=500
DIA_MAX_RETRIES=3
DIA_RETRY_DELAY=2000
DIA_CONNECTION_POOL_SIZE=10

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# SMTP Settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

DEBUG=true
LOG_LEVEL=debug